{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Flow result log",
  "type": "object",
  "required": ["log_version", "run_id", "spec_version", "calibration_set_version", "split", "git_commit", "machine", "parameters", "tests"],
  "properties": {
    "log_version": {"type": "string"},
    "run_id": {"type": "string"},
    "spec_version": {"type": "string"},
    "calibration_set_version": {"type": ["string", "null"]},
    "split": {"enum": ["dev", "test", "none"]},
    "git_commit": {"type": "string"},
    "machine": {
      "type": "object",
      "required": ["cpu", "cores", "ram_mb", "kernel", "python"],
      "properties": {"cpu": {"type": "string"}, "cores": {"type": "integer"}, "ram_mb": {"type": "integer"},
                     "kernel": {"type": "string"}, "python": {"type": "string"}, "nltk": {"type": "string"}}
    },
    "parameters": {"type": "object"},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_id", "status", "metric", "value", "threshold", "n_items", "failing_items", "notes"],
        "properties": {
          "test_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
          "status": {"enum": ["PASS", "FAIL", "ERROR", "SKIP", "UNIMPLEMENTED"]},
          "metric": {"type": "string"},
          "value": {"type": ["number", "boolean", "object", "null"]},
          "threshold": {"type": ["number", "null"]},
          "n_items": {"type": "integer", "minimum": 0},
          "failing_items": {"type": "array", "items": {"type": "string"}},
          "failure_codes": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
