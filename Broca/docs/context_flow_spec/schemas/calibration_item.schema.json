{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Flow calibration item",
  "type": "object",
  "required": ["id", "version", "tier", "split", "subject_area", "prompt_type", "turns", "response", "expect", "authored_by", "authored_date"],
  "properties": {
    "id": {"type": "string", "pattern": "^CAL-T[1-6]-S[1-9]-P([1-9]|1[0-2])-[0-9]{3}$"},
    "version": {"type": "string"},
    "tier": {"enum": ["T1", "T2", "T3", "T4", "T5", "T6"]},
    "split": {"enum": ["dev", "test"]},
    "subject_area": {"enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9"]},
    "prompt_type": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10", "P11", "P12"]},
    "turns": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["role", "text"],
                "properties": {"role": {"enum": ["user", "assistant"]}, "text": {"type": "string"}}}
    },
    "response": {
      "type": "object", "required": ["text", "units", "boundaries", "topics"],
      "properties": {
        "text": {"type": "string"},
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unit_id", "level", "text", "speech_act", "focus_entity", "relation_to_prev", "connective", "topic_id"],
            "properties": {
              "unit_id": {"type": "string"},
              "level": {"enum": ["L0", "L1", "L2", "L3"]},
              "text": {"type": "string", "minLength": 1},
              "speech_act": {"enum": ["what_does_X_do", "who_Xs", "how", "why", "where", "define_X", "yesno", "assert"]},
              "focus_entity": {"type": ["string", "null"]},
              "relation_to_prev": {"enum": [null, "R-ELAB", "R-EXAM", "R-CAUS", "R-RES", "R-EVID", "R-BACK", "R-CONC", "R-COND", "R-CONT", "R-SEQ", "R-LIST", "R-SUM"]},
              "connective": {"type": ["string", "null"]},
              "topic_id": {"type": "string"}
            }
          }
        },
        "boundaries": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "topics": {"type": "array", "items": {"type": "object", "required": ["topic_id", "label"],
                    "properties": {"topic_id": {"type": "string"}, "label": {"type": "string"}}}}
      }
    },
    "expect": {
      "type": "object",
      "properties": {
        "refusal": {"enum": [null, "EMPTY_INPUT", "NO_IN_STORE_TOKENS", "SINGLE_TOKEN_UNDEFINED", "TOO_SHORT", "ZERO_VARIANCE", "NO_IN_STORE_SUBWORD"]},
        "min_in_store_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "superseded_by": {"type": ["string", "null"]},
    "authored_by": {"type": "string"},
    "authored_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "notes": {"type": "string"}
  }
}
